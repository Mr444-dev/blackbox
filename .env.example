# Local development only. Replace both values before sharing the environment.
BLACKBOX_API_KEY=replace-with-a-random-secret-at-least-32-bytes
BLACKBOX_POSTGRES_PASSWORD=replace-this-local-database-password

# Optional host ports; change a value if that port is already occupied.
BLACKBOX_API_PORT=5000
BLACKBOX_POSTGRES_HOST_PORT=15432
BLACKBOX_KAFKA_HOST_PORT=29092
